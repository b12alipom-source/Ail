{
  "entities": {
    "ProjectFolder": {
      "title": "ProjectFolder",
      "description": "User folder organizing translated video projects.",
      "type": "object",
      "properties": {
        "syncId": {
          "type": "string",
          "description": "Stable UUID matching local Room syncId"
        },
        "name": {
          "type": "string",
          "description": "Folder display name"
        },
        "accentKey": {
          "type": "string",
          "description": "Theme accent identifier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": ["syncId", "name", "accentKey", "createdAt", "updatedAt"]
    },
    "VideoProject": {
      "title": "VideoProject",
      "description": "Translated video project metadata and summary synced for reinstall recovery.",
      "type": "object",
      "properties": {
        "syncId": {
          "type": "string",
          "description": "Stable UUID for the translated project"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "durationMs": {
          "type": "integer",
          "description": "Total video duration in milliseconds"
        },
        "sourceLanguageCode": {
          "type": "string",
          "description": "Detected or selected source language ISO code"
        },
        "sourceLanguageName": {
          "type": "string",
          "description": "Localized Arabic source language name"
        },
        "targetLanguageCode": {
          "type": "string",
          "description": "Target translation language ISO code"
        },
        "targetLanguageName": {
          "type": "string",
          "description": "Localized Arabic target language name"
        },
        "summary": {
          "type": "string",
          "description": "Concise translated summary of the video"
        },
        "cueCount": {
          "type": "integer",
          "description": "Number of timed subtitle cues"
        },
        "folderSyncId": {
          "type": "string",
          "description": "Optional parent folder syncId"
        },
        "hasArchivedVideo": {
          "type": "boolean",
          "description": "Whether a permanent device copy of the video file was archived"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "syncId",
        "title",
        "durationMs",
        "sourceLanguageCode",
        "sourceLanguageName",
        "targetLanguageCode",
        "targetLanguageName",
        "summary",
        "cueCount",
        "hasArchivedVideo",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubtitleCueChunk": {
      "title": "SubtitleCueChunk",
      "description": "Bounded batch of up to 120 timed subtitle cues belonging to a VideoProject.",
      "type": "object",
      "properties": {
        "chunkIndex": {
          "type": "integer",
          "description": "Zero-based chunk sequence index"
        },
        "cues": {
          "type": "array",
          "description": "Up to 120 subtitle cue maps {orderIndex, startMs, endMs, originalText, translatedText}"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": ["chunkIndex", "cues", "createdAt", "updatedAt"]
    },
    "StudyNotebook": {
      "title": "StudyNotebook",
      "description": "Completed study notebook with AI summaries, structured dossier, mind map, attachments index, schedule items, and tutor chat.",
      "type": "object",
      "properties": {
        "syncId": {
          "type": "string",
          "description": "Stable UUID for the study notebook"
        },
        "title": {
          "type": "string",
          "description": "Study subject title"
        },
        "preferredMethod": {
          "type": "string",
          "description": "Study method key"
        },
        "dailyMinutes": {
          "type": "integer",
          "description": "Daily study minutes budget"
        },
        "totalDays": {
          "type": "integer",
          "description": "Total study plan days"
        },
        "summaryMarkdown": {
          "type": "string",
          "description": "Generated study summary markdown"
        },
        "keyPointsText": {
          "type": "string",
          "description": "Key takeaways text"
        },
        "dossierJson": {
          "type": "string",
          "description": "Structured study dossier JSON payload"
        },
        "mindMapJson": {
          "type": "string",
          "description": "Mind map tree JSON payload"
        },
        "lastEngineLabel": {
          "type": "string",
          "description": "AI engine label that generated the latest summary"
        },
        "linkedProjectSyncId": {
          "type": "string",
          "description": "Optional linked VideoProject syncId"
        },
        "attachments": {
          "type": "array",
          "description": "Up to 25 study attachment metadata and extracted text records"
        },
        "scheduleItems": {
          "type": "array",
          "description": "Up to 60 daily study schedule items"
        },
        "messages": {
          "type": "array",
          "description": "Up to 40 recent study tutor messages"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "syncId",
        "title",
        "preferredMethod",
        "dailyMinutes",
        "totalDays",
        "summaryMarkdown",
        "keyPointsText",
        "dossierJson",
        "mindMapJson",
        "lastEngineLabel",
        "attachments",
        "scheduleItems",
        "messages",
        "createdAt",
        "updatedAt"
      ]
    },
    "VoiceTranslation": {
      "title": "VoiceTranslation",
      "description": "Instant voice or text translation history entry.",
      "type": "object",
      "properties": {
        "syncId": {
          "type": "string",
          "description": "Stable UUID for the voice translation entry"
        },
        "sourceLanguageCode": {
          "type": "string",
          "description": "Source language ISO code"
        },
        "sourceLanguageName": {
          "type": "string",
          "description": "Localized Arabic source language name"
        },
        "targetLanguageCode": {
          "type": "string",
          "description": "Target language ISO code"
        },
        "targetLanguageName": {
          "type": "string",
          "description": "Localized Arabic target language name"
        },
        "originalText": {
          "type": "string",
          "description": "Source spoken or typed text"
        },
        "translatedText": {
          "type": "string",
          "description": "Translated text"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())"
        }
      },
      "required": [
        "syncId",
        "sourceLanguageCode",
        "sourceLanguageName",
        "targetLanguageCode",
        "targetLanguageName",
        "originalText",
        "translatedText",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/folders/{folderId}": {
      "schema": { "$ref": "#/entities/ProjectFolder" },
      "description": "User folders for organizing translated video projects."
    },
    "/users/{userId}/videoProjects/{projectId}": {
      "schema": { "$ref": "#/entities/VideoProject" },
      "description": "Translated video projects with summary and metadata."
    },
    "/users/{userId}/videoProjects/{projectId}/cueChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/SubtitleCueChunk" },
      "description": "Chunked subtitle cues for a video project."
    },
    "/users/{userId}/studyNotebooks/{notebookId}": {
      "schema": { "$ref": "#/entities/StudyNotebook" },
      "description": "Completed study notebooks, summaries, mind maps, schedules, and tutor history."
    },
    "/users/{userId}/voiceTranslations/{voiceId}": {
      "schema": { "$ref": "#/entities/VoiceTranslation" },
      "description": "Instant voice and text translation history."
    }
  }
}
